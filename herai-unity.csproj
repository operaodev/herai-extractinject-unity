<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <RootNamespace>herai_unity</RootNamespace>
    <AssemblyName>herai-unity</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.4" />
    <PackageReference Include="AssetsTools.NET.MonoCecil" Version="3.0.4" />
    <PackageReference Include="AssetsTools.NET.Cpp2IL" Version="3.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="classdata.tpk" Condition="Exists('classdata.tpk')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="DownloadClassDataTpk" BeforeTargets="Build" Condition="!Exists('classdata.tpk')">
    <Message Importance="high" Text="Downloading classdata.tpk..." />
    <Exec Command="curl -sL -o uabea-ubuntu.zip &quot;https://github.com/nesrak1/UABEA/releases/download/v8/uabea-ubuntu.zip&quot;" />
    <Exec Command="unzip -o uabea-ubuntu.zip classdata.tpk" />
    <Exec Command="rm -f uabea-ubuntu.zip" />
  </Target>

  <Target Name="CopyClassDataTpk" AfterTargets="Publish" Condition="Exists('classdata.tpk')">
    <Copy SourceFiles="classdata.tpk" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
